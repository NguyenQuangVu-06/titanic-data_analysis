   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "df=pd.read_csv(\"train.csv\")\n",
    "bar = df.groupby(\"Pclass\")[\"Sex\"].value_counts().unstack()\n",
    "bar.plot(kind=\"bar\")\n",
    "plt.xlabel(\"Pclass\")\n",
    "plt.ylabel(\"Count\")\n",
    "plt.title(\"Passenger count by Class and Sex\")\n",
    "plt.legend(title=\"Sex\")\n"
   ],
