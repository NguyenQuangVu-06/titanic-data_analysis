    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "df=pd.read_csv('train.csv')\n",
    "pie = df[\"Survived\"].value_counts()\n",
    "plt.pie(pie,labels=pie.index , autopct=\"%1.1f%%\" , colors=[\"yellow\",\"skyblue\"])\n",
    "plt.legend()\n",
    "plt.title(\"PieChart\")"
   ],
