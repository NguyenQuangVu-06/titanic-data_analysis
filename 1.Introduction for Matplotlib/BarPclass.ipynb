   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "df=pd.read_csv(\"train.csv\")\n",
    "pclass_count = df[\"Pclass\"].value_counts()\n",
    "plt.bar(pclass_count.index, pclass_count, color=[\"green\",\"lightgreen\",\"skyblue\"])\n",
    "plt.title(\"Bar : Number of Pclass\")\n",
    "plt.xlabel(\"Pclass\")\n",
    "plt.ylabel(\"Number\")"
   ],
